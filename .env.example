# Platform database and Redis. Written by scripts/setup_docker_db.sh and scripts/setup_docker_redis.sh.
DATABASE_URL=
REDIS_URL=

# LiveKit project: the API issues call tokens that dispatch the voice agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared with the voice agent (backend-web/.env.local), for /internal/* only. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
INTERNAL_API_TOKEN=

# Browser origins allowed to call the API directly (the web app normally goes through its own proxy).
CORS_ORIGINS=http://localhost:3001

# Cloudflare R2, for recording playback links (the voice agent uploads the recordings).
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=talkbalt-recordings

# Emails of Talkbalt's own operators (comma separated): they can see platform-wide usage.
PLATFORM_ADMIN_EMAILS=

# Session cookies are sent over HTTPS only when true. Keep false for http://localhost.
COOKIE_SECURE=false
